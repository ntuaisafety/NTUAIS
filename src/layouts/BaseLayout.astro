---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '../styles/global.css';
import { localePath, pagePath, t, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, locale = 'en', description = t(locale, 'homeDescription') } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = pagePath(Astro.url.pathname);
const canonical = new URL(localePath(locale, path), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <title>{title} | NTUAIS</title>
    <style set:html={`
      @font-face {
        font-family: 'ProFont IIx Nerd Font';
        src: url('${base}fonts/ProFontIIxNerdFontMono-Regular.ttf') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    `} />
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
