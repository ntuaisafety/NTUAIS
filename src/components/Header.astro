---
import logoSrc from '../assets/branding/ntuais-logo.png?url';
import { t, localePath, type Locale } from '../i18n';

interface Props { locale?: Locale; path?: string }
const { locale = 'en', path = '' } = Astro.props;
const base = localePath(locale);

const navLinks = [
  { label: t(locale, 'about'),  href: 'about/'  },
  { label: t(locale, 'events'), href: 'events/' },
  { label: t(locale, 'blog'),   href: 'blog/'   },
  { label: t(locale, 'team'),   href: 'team/'   },
];
---

<header class="site-header">
  <div class="header-inner container">

    <a href={base} class="site-logo">
      <img src={logoSrc} alt="NTUAIS" width="40" height="40" />
    </a>

    <nav class="site-nav" aria-label={t(locale, 'mainNav')}>
      {navLinks.map(link => (
        <a href={`${base}${link.href}`} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <nav class="language-switch" aria-label={t(locale, 'languageNav')}>
      {(['en', 'zh-TW'] as const).map(language => (
        <a href={localePath(language, path)} lang={language} data-language-switch
          aria-current={locale === language ? 'true' : undefined}>
          {language === 'en' ? 'EN' : '繁中'}
        </a>
      ))}
    </nav>

    <a
      href="https://discord.gg/MqYwhbY6tv"
      class="btn-linear btn-linear-primary header-cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t(locale, 'joinDiscord')}
    </a>

    <button class="hamburger" id="hamburger" aria-label={t(locale, 'toggleMenu')} aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    {navLinks.map(link => (
      <a href={`${base}${link.href}`} class="mobile-nav-link">{link.label}</a>
    ))}
    <a
      href="https://discord.gg/MqYwhbY6tv"
      class="btn-linear btn-linear-primary mobile-cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t(locale, 'joinDiscord')}
    </a>
  </div>
</header>

<script>
  // Retain a same-page anchor when it also exists in the translated article.
  document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]').forEach(link => {
    const target = new URL(link.href);
    target.search = window.location.search;
    target.hash = window.location.hash;
    link.href = target.href;
  });
  const btn = document.getElementById('hamburger')!;
  const nav = document.getElementById('mobile-nav')!;

  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav.classList.toggle('is-open', !open);
    nav.setAttribute('aria-hidden', String(open));
  });

  nav.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      nav.setAttribute('aria-hidden', 'true');
    })
  );
</script>

<style>
  .language-switch { display: flex; gap: 0.2rem; flex-shrink: 0; }
  .language-switch a { padding: 0.35rem 0.5rem; border-radius: var(--border-radius-sm); color: var(--linear-subtext); font-size: 0.85rem; text-decoration: none; white-space: nowrap; }
  .language-switch a[aria-current='true'] { background: var(--linear-button-bg); color: var(--linear-button-text); }
  .language-switch a:focus-visible { outline: 2px solid var(--linear-accent-green); outline-offset: 3px; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--linear-header-bg);
    border-bottom: 1px solid var(--linear-header-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1.5rem;
  }

  .site-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .site-logo img {
    height: 40px;
    width: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--linear-subtext);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--linear-text);
    background: var(--linear-overlay-soft);
  }

  .header-cta {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Hamburger — hidden on desktop */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--linear-text);
    border-radius: 2px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile drawer — always hidden on desktop regardless of JS state */
  .mobile-nav {
    display: none;
  }

  .mobile-nav-link {
    padding: 0.625rem 0.75rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.975rem;
    font-weight: 500;
    color: var(--linear-text);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background: var(--linear-overlay-soft);
    color: var(--linear-text);
  }

  .mobile-cta {
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  /* ── Mobile: ≤768px ── */
  @media (max-width: 768px) {
    .header-inner { gap: 0.5rem; }
    .language-switch { margin-left: auto; }
    .site-nav,
    .header-cta {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    /* Only show drawer here — so resizing to desktop auto-hides it */
    .mobile-nav.is-open {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem 1.5rem 1rem;
      border-top: 1px solid var(--linear-border-subtle);
      background: var(--linear-nav-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }
</style>
