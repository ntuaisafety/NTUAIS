---
import { t, localePath, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import heroBgRaw from '../assets/backgrounds/hero-background.jpg';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const base = localePath(locale);
const discord = 'https://discord.gg/MqYwhbY6tv';

// Resize + convert to WebP. Change width/height here to crop differently.
const heroBg = await getImage({
  src: heroBgRaw,
  width: 5000,
  height: 500,
  format: 'webp',
  quality: 85,
  fit: 'cover',   // crop to fill the box exactly
});

const missionCards = [
  {
    title: t(locale, 'ourMission'),
    description: t(locale, 'missionDetail'),
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: t(locale, 'ourVision'),
    description: t(locale, 'visionDetail'),
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  },
  {
    title: t(locale, 'ourApproach'),
    description: t(locale, 'approachDetail'),
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
];

const values = [
  {
    title: t(locale, 'safetyPriority'),
    description: t(locale, 'safetyDetail'),
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: t(locale, 'technicalRigor'),
    description: t(locale, 'rigorDetail'),
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  },
  {
    title: t(locale, 'globalCollaboration'),
    description: t(locale, 'globalDetail'),
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: t(locale, 'accessibleEducation'),
    description: t(locale, 'educationDetail'),
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
];

const faq = [
  {
    question: t(locale, 'whoAreWe'),
    answer: t(locale, 'whoAnswer'),
  },
  {
    question: t(locale, 'whatIsSafety'),
    answer: t(locale, 'safetyAnswer'),
  },
  {
    question: t(locale, 'whatWeDo'),
    answer: t(locale, 'programsAnswer'),
  },
  {
    question: t(locale, 'whoShouldJoin'),
    answer: t(locale, 'joinAnswer'),
  },
  {
    question: t(locale, 'howToJoin'),
    answer: t(locale, 'involvedAnswer'),
  },
];
---

<BaseLayout locale={locale} title={t(locale, 'about')} description={t(locale, 'aboutDescription')}>

  <!-- Hero -->
  <section class="about-hero">
    <div class="about-hero-bg" style={`background-image: url('${heroBg.src}')`} aria-hidden="true"></div>
    <div class="container">
      <span class="section-badge">{t(locale, 'aboutUs')}</span>
      <h1>{t(locale, 'aboutTitle')}</h1>
      <p>{t(locale, 'aboutIntro')}</p>
      <div class="hero-cta-group">
        <a href={discord} class="btn-linear btn-linear-primary" target="_blank" rel="noopener noreferrer">{t(locale, 'joinDiscord')}</a>
        <a href={`${base}events/`} class="btn-linear btn-linear-secondary">{t(locale, 'viewEvents')}</a>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section-padded section-faq">
    <div class="container">
      <div class="section-header-left">
        <span class="section-badge section-badge--blue">{t(locale, 'drivesUs')}</span>
        <h2>{t(locale, 'missionVision')}</h2>
      </div>
      <div class="cards-grid-3">
        {missionCards.map(card => (
          <div class="card-linear icon-card">
            <div class="icon-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="22" height="22">
                <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
              </svg>
            </div>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padded">
    <div class="container">
      <div class="section-header-left">
        <span class="section-badge section-badge--green">{t(locale, 'ourValues')}</span>
        <h2>{t(locale, 'standFor')}</h2>
      </div>
      <div class="values-scroll">
        {values.map(v => (
          <div class="card-linear values-card">
            <div class="values-card-header">
              <div class="icon-card-icon icon-card-icon--sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                  <path stroke-linecap="round" stroke-linejoin="round" d={v.icon} />
                </svg>
              </div>
              <h3>{v.title}</h3>
            </div>
            <p class="values-card-body">{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padded section-faq">
    <div class="container faq-container">
      <div class="section-header-left">
        <span class="section-badge">{t(locale, 'faq')}</span>
        <h2>{t(locale, 'getToKnow')}</h2>
      </div>
      <div class="faq-list">
        {faq.map(item => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{item.question}</span>
              <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="faq-answer">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Get Involved -->
  <section class="section-padded section-alt">
    <div class="container">
      <div class="section-header-center">
        <span class="section-badge section-badge--green">{t(locale, 'joinUs')}</span>
        <h2>{t(locale, 'readyToJoin')}</h2>
      </div>
      <div class="cards-grid-2">
        <a href={discord} class="card-linear cta-card" target="_blank" rel="noopener noreferrer">
          <span class="section-badge section-badge--green">{t(locale, 'community')}</span>
          <h3>{t(locale, 'joinDiscord')}</h3>
          <p>{t(locale, 'discordIntro')}</p>
        </a>
        <a href={`${base}events/`} class="card-linear cta-card">
          <span class="section-badge section-badge--blue">{t(locale, 'programs')}</span>
          <h3>{t(locale, 'browseEvents')}</h3>
          <p>{t(locale, 'browseIntro')}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Team teaser -->
  <section class="section-padded">
    <div class="container section-header-center">
      <span class="section-badge">{t(locale, 'ourTeam')}</span>
      <h2>{t(locale, 'peopleTitle')}</h2>
      <p>{t(locale, 'teamTeaser')}</p>
      <a href={`${base}team/`} class="btn-linear btn-linear-primary" style="margin-top:1.5rem;">{t(locale, 'meetTeam')}</a>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 3.5rem;
    border-bottom: 1px solid var(--linear-border-subtle);
  }

  .about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 28, 22, 0.45);
    z-index: 0;
    pointer-events: none;
  }

  .about-hero .container {
    position: relative;
    z-index: 1;
  }

  .about-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.5;
  }

  .about-hero .section-badge {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    color: rgba(247, 250, 249, 0.9);
  }

  .about-hero h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    color: #F7FAF9;
    margin: 0.75rem 0 1rem;
    max-width: 700px;
  }

  .about-hero p {
    color: rgba(247, 250, 249, 0.8);
    max-width: 620px;
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .about-hero .btn-linear-secondary {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.35);
    color: #F7FAF9;
  }

  .about-hero .btn-linear-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #F7FAF9;
  }

  .hero-cta-group {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Sections */
  .section-padded {
    padding: 4rem 0;
  }

  .section-alt {
    background: var(--linear-overlay-soft);
  }

  /* FAQ — clean white card feel */
  .section-faq {
    background: var(--linear-bg-card);
  }

  .section-header-left {
    margin-bottom: 2rem;
  }

  .section-header-left h2,
  .section-header-center h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--linear-text-bright);
    margin: 0.5rem 0 0;
  }

  .section-header-center {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-header-center p {
    color: var(--linear-subtext);
    max-width: 500px;
    margin: 0.5rem auto 0;
  }

  /* Grids */
  .cards-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .cards-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .values-scroll {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    max-width: 1400px;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .values-scroll {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .values-scroll {
      grid-template-columns: 1fr;
    }
  }

  .values-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .values-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .values-card-header h3 {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--linear-text-bright);
  }

  .values-card-body {
    font-size: 0.875rem;
    color: var(--linear-subtext);
    line-height: 1.65;
  }

  /* Icon Cards */
  .icon-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .icon-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--linear-text-bright);
  }

  .icon-card p {
    font-size: 0.875rem;
    color: var(--linear-subtext);
    line-height: 1.65;
  }

  .icon-card--horizontal {
    flex-direction: row;
    align-items: flex-start;
    gap: 1rem;
  }

  .icon-card-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--border-radius-sm);
    background: var(--linear-overlay-soft);
    border: 1px solid var(--linear-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--linear-accent-green);
  }

  .icon-card-icon--sm {
    width: 34px;
    height: 34px;
    margin-top: 0.1rem;
  }

  /* CTA Cards */
  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--linear-text);
  }

  .cta-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--linear-text-bright);
  }

  .cta-card p {
    font-size: 0.875rem;
    color: var(--linear-subtext);
  }

  /* FAQ */
  .faq-container {
    max-width: 720px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    border: 1px solid var(--linear-border-subtle);
    border-radius: var(--border-radius-md);
    background: var(--linear-bg-card);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    cursor: pointer;
    font-weight: 500;
    color: var(--linear-text-bright);
    list-style: none;
    gap: 1rem;
    transition: background var(--transition-fast);
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question:hover {
    background: var(--linear-overlay-soft);
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--linear-muted);
    transition: transform var(--transition-fast);
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 1rem 1.25rem 1.25rem;
    font-size: 0.9rem;
    color: var(--linear-subtext);
    line-height: 1.7;
    border-top: 1px solid var(--linear-border-subtle);
  }
</style>
