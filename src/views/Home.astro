---
import { t, localePath, dateLocale, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { getLocalizedCollection } from '../i18n/content';
import { getImage, Image } from 'astro:assets';
import { isActiveEvent, startOfToday } from '../lib/eventStatus';
import heroBgRaw from '../assets/backgrounds/hero-background.jpg';
import ntuLogo from '../assets/members/ntu_logo.png';
import aicoeLogo from '../assets/members/AICoE_logo.png';
import taraLogo from '../assets/members/tara_logo.png';
import pathfinderLogo from '../assets/members/pathfinder_logo_transparent.png';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const base = localePath(locale);

// Resize + convert to WebP. Change width/height here to crop differently.
const heroBg = await getImage({
  src: heroBgRaw,
  width: 1440,
  height: 720,
  format: 'webp',
  quality: 70,
  fit: 'cover',   // crop to fill the box exactly
});

const collaborators = [
  { name: 'National Taiwan University', logo: ntuLogo, url: 'https://www.ntu.edu.tw/' },
  { name: 'AICoE', logo: aicoeLogo, url: 'https://www.twaicoe.org' },
  { name: 'TARA', logo: taraLogo, url: 'https://www.taraprogram.org/' },
  { name: 'Pathfinder', logo: pathfinderLogo, url: 'https://pathfinder.kairos-project.org/' },
];

// Show events that haven't finished yet (upcoming + running), sorted soonest first
const allEvents = await getLocalizedCollection('events', locale);
const today = startOfToday();
const upcomingEvents = allEvents
  .filter(e => isActiveEvent(e.data.date, e.data.endDate, today))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout locale={locale} title={t(locale, 'home')} description={t(locale, 'homeDescription')}>

  <!-- Hero -->
  <section class="hero-linear" aria-label={t(locale, 'hero')}>
    <!-- Image layer: adjust opacity here ↓ (0 = invisible, 1 = full) -->
    <div class="hero-bg" style={`background-image: url('${heroBg.src}')`} aria-hidden="true"></div>
    <div class="hero-linear-overlay" aria-hidden="true"></div>
    <div class="hero-linear-inner">
      <p class="hero-subtitle">NTU AI Safety</p>
      <h1>
        <span class="hero-title">{t(locale, 'heroTitle')}</span>{locale === 'en' ? <br /> : ' '}
        <span class="hero-accent">AI Safety</span>
        {t(locale, 'heroTitleSuffix') && <span class="hero-title">{' '}{t(locale, 'heroTitleSuffix')}</span>}
      </h1>
      <p class="hero-description">{t(locale, 'heroDescription')}</p>
      <div class="hero-cta-group">
        <a href="https://discord.gg/MqYwhbY6tv" class="btn-linear btn-linear-primary" target="_blank" rel="noopener noreferrer">{t(locale, 'joinCommunity')}</a>
        <a href={`${base}events/`} class="btn-linear btn-linear-secondary">{t(locale, 'viewEvents')}</a>
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  {upcomingEvents.length > 0 && (
    <section class="section-events">
      <div class="container">
        <div class="section-header">
          <span class="section-badge">{t(locale, 'upcoming')}</span>
          <h2>{t(locale, 'programsEvents')}</h2>
          <p>{t(locale, 'eventsIntro')}</p>
        </div>
        <div class="events-grid">
          {upcomingEvents.map(event => (
            <a href={`${base}events/${event.slug}/`} class="card-linear event-card">
              <span class={`section-badge section-badge--${event.data.badge_color ?? 'green'}`}>
                {event.data.badge ?? t(locale, 'event')}
              </span>
              <h3>{event.data.title}</h3>
              <p>{event.data.description}</p>
              <time class="event-date" datetime={event.data.date.toISOString()}>
                {event.data.date.toLocaleDateString(dateLocale(locale), { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
        <div class="section-footer">
          <a href={`${base}events/`} class="btn-linear btn-linear-secondary">{t(locale, 'allEvents')}</a>
        </div>
      </div>
    </section>
  )}

  <!-- Photo Gallery Carousel -->
  <PhotoCarousel locale={locale} />

  <!-- Mission Section -->
  <section class="section-mission">
    <div class="container section-mission-inner">
      <div>
        <span class="section-badge section-badge--blue">{t(locale, 'mission')}</span>
        <h2>{t(locale, 'whySafety')}</h2>
        <p>{t(locale, 'missionIntro')}</p>
        <p>{t(locale, 'missionCommunity')}</p>
      </div>
      <div class="mission-stats">
        <div class="stat-card">
          <span class="stat-number">3+</span>
          <span class="stat-label">{t(locale, 'activePrograms')}</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">50+</span>
          <span class="stat-label">{t(locale, 'communityMembers')}</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">2+</span>
          <span class="stat-label">{t(locale, 'yearsRunning')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Collaborators -->
  <section class="section-collaborators">
    <div class="container">
      <p class="collab-label">{t(locale, 'collaborators')}</p>
      <div class="collab-logos">
        {collaborators.map(c => (
          <a href={c.url} class="collab-item" target="_blank" rel="noopener noreferrer" aria-label={c.name}>
            <Image src={c.logo} alt={`${c.name} logo`} class="collab-logo" />
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 1;
  }

  .hero-cta-group {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .hero-subtitle {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(247, 250, 249, 0.6);
    margin-bottom: 1rem;
  }

  .hero-cta-group .btn-linear-secondary {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.35);
    color: #F7FAF9;
  }

  .hero-cta-group .btn-linear-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #F7FAF9;
  }

  /* Events */
  .section-events {
    padding: 4rem 0;
    background: var(--linear-upcoming-bg);
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--linear-text-bright);
    margin: 0.75rem 0 0.5rem;
  }

  .section-header p {
    color: var(--linear-subtext);
    max-width: 500px;
    margin: 0 auto;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .event-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--linear-text);
  }

  .event-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--linear-text-bright);
  }

  .event-card p {
    font-size: 0.875rem;
    color: var(--linear-subtext);
    flex: 1;
  }

  .event-date {
    font-size: 0.8rem;
    color: var(--linear-muted);
    font-weight: 500;
  }

  .section-footer {
    text-align: center;
    margin-top: 2rem;
  }

  /* Mission */
  .section-mission {
    padding: 5rem 0;
  }

  .section-mission-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .section-mission h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--linear-text-bright);
    margin: 0.75rem 0 1rem;
  }

  .section-mission p {
    color: var(--linear-subtext);
    margin-bottom: 1rem;
  }

  .mission-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .stat-card {
    background: var(--linear-bg-card);
    border: 1px solid var(--linear-border-subtle);
    border-radius: var(--border-radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--linear-accent-green);
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--linear-subtext);
  }

  /* Collaborators */
  .section-collaborators {
    padding: 3rem 0;
    border-top: 1px solid var(--linear-border-subtle);
  }

  .collab-label {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--linear-muted);
    margin-bottom: 1.75rem;
  }

  .collab-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .collab-item {
    display: flex;
    align-items: center;
  }

  .collab-logo {
    height: 72px;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .section-mission-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .mission-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
