---
import View from '../../../views/Post.astro';
import { getLocalizedCollection } from '../../../i18n/content';
export async function getStaticPaths() {
  const entries = await getLocalizedCollection('blog', 'zh-TW');
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { post: entry } }));
}
---
<View locale="zh-TW" post={Astro.props.post} />
